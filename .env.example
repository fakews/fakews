# FakeWS Configuration
# Copy to .env and modify as needed

# Network name for docker-compose
FAKEWS_NETWORK=fakews

# Domain suffix for service routing
DOMAIN_SUFFIX=aws.localhost

# Default AWS region
DEFAULT_REGION=eu-west-1

# Minio S3 credentials
MINIO_ROOT_USER=mock1234
MINIO_ROOT_PASSWORD=mock1234

# Port mappings (change if you have conflicts)
CONSOLE_PORT=3000
CONSOLE_API_PORT=3001
S3_API_PORT=9000
S3_CONSOLE_PORT=9090
COGNITO_PORT=9229
SSM_PORT=9230
DYNAMODB_PORT=8000
SNS_PORT=9911
SQS_PORT=9324
SQS_UI_PORT=9325
IAM_PORT=5050
CLOUDWATCH_PORT=5051
LOGS_PORT=5052
